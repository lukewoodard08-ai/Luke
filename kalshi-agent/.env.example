# Copy to .env for local development, or set these as secrets in Base44.
# NEVER commit a filled-in .env - only this example belongs in git.

# --- Environment -------------------------------------------------------
# demo | prod   (defaults to demo so a misconfig cannot touch real money)
KALSHI_ENV=demo

# --- Credentials -------------------------------------------------------
# API key ID shown in the Kalshi web app under Account -> API Keys.
KALSHI_API_KEY_ID=

# Supply the private key ONE of two ways.
# 1) Inline PEM. Secret managers that strip newlines can use literal \n.
KALSHI_PRIVATE_KEY=
# 2) Or point at the .pem file downloaded when the key was created.
KALSHI_PRIVATE_KEY_PATH=
# Only if the key is passphrase-protected.
KALSHI_PRIVATE_KEY_PASSPHRASE=

# --- Safety ------------------------------------------------------------
# true  = log intended orders, never call the execution endpoint (default)
# false = place REAL orders
KALSHI_DRY_RUN=true

# --- Objective ---------------------------------------------------------
# Series the monitor tracks. KXPRESPARTY = presidential election by party.
KALSHI_TARGET_SERIES=KXPRESPARTY

# --- Resilience / logging ---------------------------------------------
KALSHI_REQUEST_TIMEOUT=15
KALSHI_MAX_RETRIES=4
KALSHI_BACKOFF_BASE=1.5
KALSHI_BACKOFF_CAP=30
KALSHI_LOG_LEVEL=INFO
